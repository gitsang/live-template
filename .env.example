# 本地开发用环境变量覆盖（复制为 .env 后按需修改）
# 该文件本身会被 git 跟踪，.env 不会被跟踪。

# 监听
PORT=8080
HOST=0.0.0.0

# B 站直播间（支持短号，服务端自动解析为真实房间号）
ROOM_ID=90932

# 开发开关：mock 弹幕 + mock 手柄，无需联网/手柄
MOCK=0

# 调试控制条（默认关，OBS 中应保持关闭）
HUD=0

# 视频框透明洞（默认开）
VIDEO_HOLE=1

# 弹幕落盘目录
DATA_DIR=./data

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
